<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sleep_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sleep_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp">

                <ImageView
                    android:id="@+id/sleep_me_dot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/sleep_widget_dot" />

                <TextView
                    android:id="@+id/sleep_me_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/sleep_me_line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F3F0FF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp">

                <ImageView
                    android:id="@+id/sleep_partner_dot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/sleep_widget_dot" />

                <TextView
                    android:id="@+id/sleep_partner_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/sleep_partner_line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#A9A3DD"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/sleep_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/sleep_widget_button"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:text="Going to sleep"
        android:textColor="#3D2600"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
