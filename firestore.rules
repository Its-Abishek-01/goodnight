rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Single-use join codes. Only direct lookups, never listing.
    match /pairCodes/{code} {
      allow get, create, delete: if request.auth != null;
    }

    match /pairs/{pairId} {
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];

      // A waiting pair (one member) is readable so a partner can join with its code.
      allow get: if request.auth != null
        && (request.auth.uid in resource.data.members
            || resource.data.members.size() == 1);

      allow update: if request.auth != null
        && (request.auth.uid in resource.data.members
            || (resource.data.members.size() == 1
                && request.resource.data.members.size() == 2
                && request.auth.uid in request.resource.data.members));
    }
  }
}
