rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function pairMembers(pairId) {
      return get(/databases/$(database)/documents/pairs/$(pairId)).data.members;
    }

    // "Delete my data": a member marks the pair closing, then may delete
    // everything under it. Normal deletes stay limited by the rules below.
    function closingByMember(pairId) {
      let pair = get(/databases/$(database)/documents/pairs/$(pairId)).data;
      return request.auth != null
        && request.auth.uid in pair.members
        && pair.get('closing', false) == true;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Single-use join codes. Only direct lookups, never listing.
    match /pairCodes/{code} {
      allow get, create, delete: if request.auth != null;
    }

    match /pairs/{pairId} {
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];

      // A waiting pair (one member) is readable so a partner can join with its code.
      allow get: if request.auth != null
        && (request.auth.uid in resource.data.members
            || resource.data.members.size() == 1);

      allow update: if request.auth != null
        && (request.auth.uid in resource.data.members
            || (resource.data.members.size() == 1
                && request.resource.data.members.size() == 2
                && request.auth.uid in request.resource.data.members));

      allow delete: if request.auth != null
        && request.auth.uid in resource.data.members
        && resource.data.get('closing', false) == true;

      // Nightly log. Each person can only change their own entry. Forgiveness
      // needs one person to ask and the OTHER person to agree.
      match /nights/{key} {
        allow delete: if closingByMember(pairId);

        allow read: if request.auth != null
          && request.auth.uid in pairMembers(pairId);

        allow create: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && request.resource.data.players.keys().hasOnly([request.auth.uid]);

        allow update: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && request.resource.data.players.diff(resource.data.players)
               .affectedKeys().hasOnly([request.auth.uid])
          && (request.resource.data.get('forgiven', false)
                == resource.data.get('forgiven', false)
              || (resource.data.get('forgiveBy', null) != null
                  && resource.data.get('forgiveBy', null) != request.auth.uid));
      }

      // Streak milestones. A grant is kept forever so a coupon is earned once.
      match /grants/{id} {
        allow delete: if closingByMember(pairId);

        allow read: if request.auth != null
          && request.auth.uid in pairMembers(pairId);
        allow create: if request.auth != null
          && request.auth.uid in pairMembers(pairId);
      }

      // Single-use coupons. Only the holder can use one; only the partner can
      // delete it, after it has been used.
      match /coupons/{id} {
        allow delete: if closingByMember(pairId);

        allow read: if request.auth != null
          && request.auth.uid in pairMembers(pairId);

        allow create: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && request.resource.data.status == 'ready'
          && request.resource.data.holder in pairMembers(pairId)
          && existsAfter(/databases/$(database)/documents/pairs/$(pairId)/grants/$(request.resource.data.grantId));

        allow update: if request.auth != null
          && resource.data.holder == request.auth.uid
          && resource.data.status == 'ready'
          && request.resource.data.status == 'redeemed'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'title', 'redeemedAt']);

        allow delete: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && resource.data.status == 'redeemed'
          && resource.data.holder != request.auth.uid;
      }

      // Private selfies between the two partners. The image is stored in the
      // document. Only the receiver can set the read receipt (seenAt), once.
      match /selfies/{id} {
        allow delete: if closingByMember(pairId);

        allow read: if request.auth != null
          && request.auth.uid in pairMembers(pairId);

        allow create: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.image.size() < 800000
          && request.resource.data.seenAt == null;

        allow update: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && resource.data.from != request.auth.uid
          && resource.data.seenAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt']);

        allow delete: if request.auth != null
          && resource.data.from == request.auth.uid;
      }

      // Feature choices. Each person's own doc (keyed by uid) is theirs alone.
      // The `shared` doc works like a schedule: one person proposes, only the
      // OTHER person can approve, and either of them can clear a proposal.
      match /features/{id} {
        allow delete: if closingByMember(pairId);

        allow read: if request.auth != null
          && request.auth.uid in pairMembers(pairId);

        allow create, update: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && id == request.auth.uid
          && request.resource.data.keys().hasOnly(['alarm', 'nightMode', 'reminders'])
          && request.resource.data.alarm is bool
          && request.resource.data.nightMode is bool
          && request.resource.data.reminders is bool;

        allow create: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && id == 'shared'
          && request.resource.data.current == null
          && request.resource.data.proposal.by == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && id == 'shared'
          && (
            // propose or counter-propose: approved features must not change
            (request.resource.data.proposal != null
              && request.resource.data.proposal.by == request.auth.uid
              && request.resource.data.current == resource.data.current)
            // withdraw or decline
            || (request.resource.data.proposal == null
              && request.resource.data.current == resource.data.current)
            // approve: only by someone who did not make the proposal
            || (resource.data.proposal != null
              && resource.data.proposal.by != request.auth.uid
              && request.resource.data.proposal == null
              && request.resource.data.current.streak == resource.data.proposal.streak
              && request.resource.data.current.moments == resource.data.proposal.moments)
          );
      }

      // Profile photo per person: both can see it, only the owner changes it.
      match /profiles/{uid} {
        allow delete: if closingByMember(pairId);

        allow read: if request.auth != null
          && request.auth.uid in pairMembers(pairId);

        allow create, update: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['photo', 'updatedAt'])
          && (request.resource.data.photo == null
              || request.resource.data.photo.size() < 200000);
      }

      // What you privately call your partner (pet name, your photo of them).
      // Only the owner can read or write their own doc.
      match /nicknames/{uid} {
        allow delete: if closingByMember(pairId);

        allow read: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && uid == request.auth.uid;

        allow create, update: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['petName', 'photo', 'updatedAt'])
          && (!('petName' in request.resource.data)
              || request.resource.data.petName == null
              || (request.resource.data.petName is string
                  && request.resource.data.petName.size() <= 40))
          && (!('photo' in request.resource.data)
              || request.resource.data.photo == null
              || request.resource.data.photo.size() < 200000);
      }

      // One schedule per person. A person proposes a window; only the OTHER
      // person can approve it, which moves it into `current` (locked).
      match /schedules/{owner} {
        allow delete: if closingByMember(pairId);

        allow read: if request.auth != null
          && request.auth.uid in pairMembers(pairId);

        allow create: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && owner in pairMembers(pairId)
          && request.resource.data.current == null
          && request.resource.data.proposal.by == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && (
            // propose or counter-propose: approved window must not change
            (request.resource.data.proposal != null
              && request.resource.data.proposal.by == request.auth.uid
              && request.resource.data.current == resource.data.current)
            // approve: only by someone who did not make the proposal
            || (resource.data.proposal != null
              && resource.data.proposal.by != request.auth.uid
              && request.resource.data.proposal == null
              && request.resource.data.current.bedtime == resource.data.proposal.bedtime
              && request.resource.data.current.wake == resource.data.proposal.wake)
          );
      }
    }
  }
}
