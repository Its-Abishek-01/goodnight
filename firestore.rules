rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function pairMembers(pairId) {
      return get(/databases/$(database)/documents/pairs/$(pairId)).data.members;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Single-use join codes. Only direct lookups, never listing.
    match /pairCodes/{code} {
      allow get, create, delete: if request.auth != null;
    }

    match /pairs/{pairId} {
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];

      // A waiting pair (one member) is readable so a partner can join with its code.
      allow get: if request.auth != null
        && (request.auth.uid in resource.data.members
            || resource.data.members.size() == 1);

      allow update: if request.auth != null
        && (request.auth.uid in resource.data.members
            || (resource.data.members.size() == 1
                && request.resource.data.members.size() == 2
                && request.auth.uid in request.resource.data.members));

      // Nightly log. Each person can only change their own entry. Forgiveness
      // needs one person to ask and the OTHER person to agree.
      match /nights/{key} {
        allow read: if request.auth != null
          && request.auth.uid in pairMembers(pairId);

        allow create: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && request.resource.data.players.keys().hasOnly([request.auth.uid]);

        allow update: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && request.resource.data.players.diff(resource.data.players)
               .affectedKeys().hasOnly([request.auth.uid])
          && (request.resource.data.get('forgiven', false)
                == resource.data.get('forgiven', false)
              || (resource.data.get('forgiveBy', null) != null
                  && resource.data.get('forgiveBy', null) != request.auth.uid));
      }

      // One schedule per person. A person proposes a window; only the OTHER
      // person can approve it, which moves it into `current` (locked).
      match /schedules/{owner} {
        allow read: if request.auth != null
          && request.auth.uid in pairMembers(pairId);

        allow create: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && owner in pairMembers(pairId)
          && request.resource.data.current == null
          && request.resource.data.proposal.by == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid in pairMembers(pairId)
          && (
            // propose or counter-propose: approved window must not change
            (request.resource.data.proposal != null
              && request.resource.data.proposal.by == request.auth.uid
              && request.resource.data.current == resource.data.current)
            // approve: only by someone who did not make the proposal
            || (resource.data.proposal != null
              && resource.data.proposal.by != request.auth.uid
              && request.resource.data.proposal == null
              && request.resource.data.current.bedtime == resource.data.proposal.bedtime
              && request.resource.data.current.wake == resource.data.proposal.wake)
          );
      }
    }
  }
}
